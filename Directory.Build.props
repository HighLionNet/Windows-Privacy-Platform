<Project>
  <PropertyGroup>
    <!-- The only literal application version in the repository. -->
    <Version>2.2.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' == ''">$(Version)</InformationalVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' != ''">$(Version)+$(SourceRevisionId)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Windows Privacy Platform</Product>
    <Company>HighLionNet</Company>
    <Authors>HighLionNet</Authors>
    <Copyright>Copyright © HighLionNet 2026</Copyright>
    <Description>Evidence-driven Windows privacy and configuration inspection and management</Description>
    <RepositoryUrl>https://github.com/HighLionNet/Windows-Privacy-Platform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="BuildIdentifier" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
  </ItemGroup>
</Project>
