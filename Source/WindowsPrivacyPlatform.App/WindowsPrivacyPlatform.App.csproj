<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
    <StartupObject>WindowsPrivacyPlatform.App.App</StartupObject>
    <RootNamespace>WindowsPrivacyPlatform.App</RootNamespace>
    <AssemblyName>WindowsPrivacyPlatform</AssemblyName>
    <Version>1.6.0</Version>
    <AssemblyTitle>Windows Privacy Platform</AssemblyTitle>
    <Product>Windows Privacy Platform</Product>
    <Description>Windows privacy and security knowledge explorer with confirmed Modify writes</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsPrivacyPlatform.Models\WindowsPrivacyPlatform.Models.csproj" />
    <ProjectReference Include="..\WindowsPrivacyPlatform.Core\WindowsPrivacyPlatform.Core.csproj" />
    <ProjectReference Include="..\WindowsPrivacyPlatform.Logging\WindowsPrivacyPlatform.Logging.csproj" />
    <ProjectReference Include="..\WindowsPrivacyPlatform.KnowledgeBase\WindowsPrivacyPlatform.KnowledgeBase.csproj" />
    <ProjectReference Include="..\WindowsPrivacyPlatform.Validator\WindowsPrivacyPlatform.Validator.csproj" />
    <ProjectReference Include="..\WindowsPrivacyPlatform.Scanner\WindowsPrivacyPlatform.Scanner.csproj" />
  </ItemGroup>

</Project>
