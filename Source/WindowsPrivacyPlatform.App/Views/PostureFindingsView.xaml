<UserControl x:Class="WindowsPrivacyPlatform.App.Views.PostureFindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="SubtitleText" Visibility="Collapsed"/>
    <Border Style="{StaticResource HeaderRule}"/>
    <Border Style="{StaticResource ListContainer}"><StackPanel x:Name="Rows"/></Border>
  </StackPanel>
</UserControl>
