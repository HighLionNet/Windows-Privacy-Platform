<UserControl x:Class="WindowsPrivacyPlatform.App.Views.SystemInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="System Inventory" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="CountText" Style="{StaticResource SectionSubtitle}" />
    <Border Style="{StaticResource HeaderRule}" />

    <Border Style="{StaticResource CardAccent}" Margin="0,0,0,14" Background="{StaticResource BrushAccentSoft}">
      <StackPanel>
        <TextBlock Text="Read-only diagnostic inventory" FontWeight="SemiBold" FontSize="13" />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18"
                   Text="This is what is installed and running on this device. Most items are not intended to be changed here. Use this inventory to identify components and activity; use Settings for approved configuration changes." />
      </StackPanel>
    </Border>

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="230" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FilterBox" Height="30" Padding="8,4" VerticalContentAlignment="Center"
               ToolTip="Filter inventory by name, state, identifier, or technical location" />
      <ComboBox x:Name="CategoryFilter" Grid.Column="1" Height="30" Margin="10,0,0,0"
                VerticalContentAlignment="Center" />
    </Grid>

    <Border Style="{StaticResource ListContainer}">
      <StackPanel>
        <Border Style="{StaticResource ListHeader}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Inventory item" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="1" Text="Observed state" FontWeight="SemiBold" FontSize="11" />
          </Grid>
        </Border>
        <ItemsControl x:Name="InventoryList" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
