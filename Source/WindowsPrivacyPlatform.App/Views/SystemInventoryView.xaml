<UserControl x:Class="WindowsPrivacyPlatform.App.Views.SystemInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="System Explorer" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource HeaderRule}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource FilterBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="SEARCH" Style="{StaticResource FilterLabel}"/>
        <TextBox x:Name="FilterBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="Search inventory"/>
        <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource FilterLabel}" Margin="12,0,8,0"/>
        <ComboBox x:Name="TypeFilter" Grid.Column="3" Height="34" IsTextSearchEnabled="True" AutomationProperties.Name="Filter inventory by type"/>
        <TextBlock Grid.Column="4" Text="GROUP" Style="{StaticResource FilterLabel}" Margin="12,0,8,0"/>
        <ComboBox x:Name="GroupFilter" Grid.Column="5" Height="34" IsTextSearchEnabled="True" AutomationProperties.Name="Filter inventory by group"/>
      </Grid>
    </Border>

    <DockPanel Grid.Row="2" Margin="2,0,2,8" LastChildFill="False">
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource BrushTextSecondary}"
                 FontSize="11" FontWeight="SemiBold" Margin="18,0,0,0" />
    </DockPanel>

    <Grid Grid.Row="3" Style="{StaticResource ResultsDivider}">
      <Border Width="132" Background="{DynamicResource BrushAccent}" HorizontalAlignment="Left"/>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource ListContainer}" Margin="0">
      <ListBox x:Name="ExplorerList" BorderThickness="0" Background="Transparent"
               ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource ListRowButton}" Click="ExplorerRow_Click" Tag="{Binding ObjectId}"
                    ToolTip="Open observed component details">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,1,12,1">
                  <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushAccent}" />
                  <TextBlock Text="{Binding Group}" FontSize="10" TextWrapping="Wrap"
                             Foreground="{DynamicResource BrushTextMuted}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,1,16,1">
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Path}" FontSize="10" FontFamily="Cascadia Mono, Consolas"
                             Foreground="{DynamicResource BrushTextMuted}" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11" FontFamily="Cascadia Mono, Consolas"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
