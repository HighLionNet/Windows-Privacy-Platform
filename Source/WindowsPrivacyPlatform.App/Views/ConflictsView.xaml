<UserControl x:Class="WindowsPrivacyPlatform.App.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Layer conflicts" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="SubtitleText" Style="{StaticResource SectionSubtitle}"
               Text="Settings where observed configuration layers disagree." />
    <ItemsControl x:Name="List" />
  </StackPanel>
</UserControl>
