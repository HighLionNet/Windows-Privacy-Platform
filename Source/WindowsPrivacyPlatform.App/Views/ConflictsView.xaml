<UserControl x:Class="WindowsPrivacyPlatform.App.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock Text="Conflicts" Style="{StaticResource SectionTitle}"/>
    <Border Style="{StaticResource HeaderRule}"/>
    <Border Style="{StaticResource FilterBar}" BorderBrush="{DynamicResource BrushConflict}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <WrapPanel>
          <TextBlock Text="SEARCH" Style="{StaticResource FilterLabel}" Margin="0,0,8,8"/>
          <TextBox x:Name="SearchBox" MinWidth="240" Height="34" VerticalContentAlignment="Center" Margin="0,0,14,8" TextChanged="FilterChanged" AutomationProperties.Name="Search conflicts"/>
          <TextBlock Text="IMPACT" Style="{StaticResource FilterLabel}" Margin="0,0,8,8"/>
          <ComboBox x:Name="ImpactBox" MinWidth="130" Height="34" Margin="0,0,14,8" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter by impact">
            <ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/>
          </ComboBox>
          <TextBlock Text="STATE" Style="{StaticResource FilterLabel}" Margin="0,0,8,8"/>
          <ComboBox x:Name="StateBox" MinWidth="210" Height="34" Margin="0,0,8,8" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter by state">
            <ComboBoxItem Content="Open" IsSelected="True"/><ComboBoxItem Content="Resolved this session"/>
          </ComboBox>
        </WrapPanel>
        <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply (0)" Style="{StaticResource ActionPrimary}"
                Margin="16,0,0,0" MinWidth="128" VerticalAlignment="Top" Click="Apply_Click" IsEnabled="False"/>
      </Grid>
    </Border>
    <Grid Style="{StaticResource ResultsDivider}"><Border Width="132" Background="{DynamicResource BrushConflict}" HorizontalAlignment="Left"/></Grid>
    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="4,8" Foreground="{DynamicResource BrushTextMuted}" Text="No conflict groups match these filters."/>
    <StackPanel x:Name="GroupsPanel"/>
  </StackPanel>
</UserControl>
