<UserControl x:Class="WindowsPrivacyPlatform.App.Views.DnsResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="SubtitleText" TextWrapping="Wrap"/>
    <Border Style="{StaticResource HeaderRule}"/>
    <StackPanel x:Name="AnswerPanel"/>
    <Border x:Name="PolicyPanel" Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="BOUNDED DNS SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
        <TextBlock Text="DoH, multicast name resolution, and NetBIOS remain curated registry Settings. Adapter DNS changes are not authorized in this version." Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        <WrapPanel>
          <Button Content="Windows DoH policy" Tag="policy.network.dohmode" Style="{StaticResource ActionNeutral}" Margin="0,0,8,7" Click="Setting_Click"/>
          <Button Content="LLMNR policy" Tag="policy.network.llmnr" Style="{StaticResource ActionNeutral}" Margin="0,0,8,7" Click="Setting_Click"/>
          <Button Content="NetBIOS policy" Tag="policy.network.netbios" Style="{StaticResource ActionNeutral}" Margin="0,0,8,7" Click="Setting_Click"/>
          <Button Content="Windows network settings" Style="{StaticResource ActionNeutral}" Margin="0,0,0,7" Click="NetworkSettings_Click"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <TextBlock x:Name="InterfacesHeading" Text="INTERFACES IN PLAY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="2,3,0,7"/>
    <StackPanel x:Name="InterfacePanel"/>
    <TextBlock x:Name="ProbeHeading" Text="OBSERVED-RESOLVER PROBES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="2,5,0,7"/>
    <StackPanel x:Name="ProbePanel"/>
  </StackPanel>
</UserControl>
