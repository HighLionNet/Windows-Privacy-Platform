<UserControl x:Class="WindowsPrivacyPlatform.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Machine Overview" Style="{StaticResource SectionTitle}" />
    <TextBlock Text="Device context only — not a security score. Unknown values stay Unknown."
               Style="{StaticResource SectionSubtitle}" />

    <Border Style="{StaticResource Card}" Background="{StaticResource BrushAccentSoft}" BorderThickness="0" Padding="14,10">
      <TextBlock TextWrapping="Wrap" FontSize="13"
                 Text="Inspect mode · read-only discovery. No registry, service, task, policy, or firewall changes. Elevation was not requested." />
    </Border>

    <!-- Primary identity cards -->
    <UniformGrid Columns="2">
      <Border Style="{StaticResource Card}" Margin="0,0,8,12">
        <StackPanel>
          <TextBlock Text="Operating system" Style="{StaticResource LabelMuted}" />
          <TextBlock x:Name="OsText" Style="{StaticResource PrimaryValue}" Margin="0,4,0,0" />
          <TextBlock x:Name="ArchText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="8,0,0,12">
        <StackPanel>
          <TextBlock Text="Device" Style="{StaticResource LabelMuted}" />
          <TextBlock x:Name="DeviceText" Style="{StaticResource PrimaryValue}" Margin="0,4,0,0" />
          <TextBlock x:Name="CpuText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
          <TextBlock x:Name="MemText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,12">
        <StackPanel>
          <TextBlock Text="Security posture (observed)" Style="{StaticResource LabelMuted}" />
          <TextBlock x:Name="SecureBootText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
          <TextBlock x:Name="TpmText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
          <TextBlock x:Name="BitLockerText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="8,0,0,12">
        <StackPanel>
          <TextBlock Text="Services and network" Style="{StaticResource LabelMuted}" />
          <TextBlock x:Name="FirewallText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
          <TextBlock x:Name="DefenderText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
          <TextBlock x:Name="DomainText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Attention row -->
    <Border x:Name="ConflictsCard" Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <TextBlock Text="Attention" Style="{StaticResource LabelMuted}" DockPanel.Dock="Left" />
          <Button x:Name="OpenConflictsBtn" Content="Open Conflicts" Style="{StaticResource LinkButton}"
                  HorizontalAlignment="Right" DockPanel.Dock="Right" Visibility="Collapsed" />
        </DockPanel>
        <TextBlock x:Name="ConflictsText" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <!-- Scan meta (concise) -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Scan and knowledge" Style="{StaticResource LabelMuted}" />
        <TextBlock x:Name="ScanMetaText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- Expandable technical evidence -->
    <Expander Header="Identity collection notes" Style="{StaticResource DetailExpander}" IsExpanded="False">
      <Border Style="{StaticResource Card}" Margin="0,6,0,0">
        <TextBlock x:Name="IdentityNotesText" Style="{StaticResource ValueText}"
                   Foreground="{StaticResource BrushTextSecondary}" />
      </Border>
    </Expander>

    <Expander Header="Observation summary" Style="{StaticResource DetailExpander}" IsExpanded="False">
      <Border Style="{StaticResource Card}" Margin="0,6,0,0">
        <TextBlock x:Name="SummaryText" Style="{StaticResource ValueText}" />
      </Border>
    </Expander>

    <!-- Quick navigation -->
    <TextBlock Text="Quick navigation" Style="{StaticResource LabelMuted}" Margin="0,12,0,8" />
    <WrapPanel x:Name="QuickNavPanel" />
  </StackPanel>
</UserControl>
