<UserControl x:Class="WindowsPrivacyPlatform.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock Text="Privacy &amp; Security Overview" Style="{StaticResource SectionTitle}" />
    <TextBlock Text="High-impact observations from configured policies. Unknown values are never counted as safe."
               Style="{StaticResource SectionSubtitle}" />
    <Border Style="{StaticResource HeaderRule}" />

    <UniformGrid Columns="3" Rows="1" Margin="0,0,0,14">
      <Border Style="{StaticResource Card}" Margin="0,0,8,0">
        <StackPanel><TextBlock Text="HIGH ATTENTION" FontSize="10" Foreground="{StaticResource BrushConflict}" FontWeight="SemiBold" />
          <TextBlock x:Name="HighCountText" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="4,0,4,0">
        <StackPanel><TextBlock Text="REVIEW" FontSize="10" Foreground="{StaticResource BrushWarning}" FontWeight="SemiBold" />
          <TextBlock x:Name="ReviewCountText" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="8,0,0,0">
        <StackPanel><TextBlock Text="PROTECTIONS OBSERVED" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold" />
          <TextBlock x:Name="ProtectedCountText" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel>
      </Border>
    </UniformGrid>

    <Border Style="{StaticResource PropertySheet}" Margin="0,0,0,14">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}"><TextBlock Text="Attention priorities" FontWeight="SemiBold" /></Border>
        <StackPanel x:Name="FindingsList" Margin="0,2,0,2" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource PropertySheet}" Margin="0,0,0,12">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}"><TextBlock Text="Windows security essentials" FontWeight="SemiBold" /></Border>
        <Grid Margin="0,4,0,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="Secure Boot" Style="{StaticResource SheetLabel}" /><TextBlock x:Name="SecureBootText" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="1" Text="TPM" Style="{StaticResource SheetLabel}" /><TextBlock x:Name="TpmText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="2" Text="BitLocker" Style="{StaticResource SheetLabel}" /><TextBlock x:Name="BitLockerText" Grid.Row="2" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="3" Text="Firewall" Style="{StaticResource SheetLabel}" /><TextBlock x:Name="FirewallText" Grid.Row="3" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="4" Text="Defender" Style="{StaticResource SheetLabel}" /><TextBlock x:Name="DefenderText" Grid.Row="4" Grid.Column="1" Style="{StaticResource SheetValue}" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock x:Name="PlatformText" Margin="2,2,2,0" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
  </StackPanel>
</UserControl>
