<UserControl x:Class="WindowsPrivacyPlatform.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock Text="Dashboard" Style="{StaticResource SectionTitle}"/>
    <Border Style="{StaticResource HeaderRule}"/>

    <Border Style="{StaticResource PropertySheet}" Margin="0,0,0,14" BorderThickness="4,1,1,1" BorderBrush="{DynamicResource BrushAccent}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}"><TextBlock Text="This PC" FontWeight="SemiBold"/></Border>
        <Grid Margin="16,9,16,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Computer" Style="{StaticResource PropLabel}"/><TextBlock x:Name="ComputerText" Grid.Column="1" Style="{StaticResource PropValue}" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="2" Text="Signed-in user" Style="{StaticResource PropLabel}"/><TextBlock x:Name="UserText" Grid.Column="3" Style="{StaticResource PropValue}" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="Account" Style="{StaticResource PropLabel}"/><TextBlock x:Name="AccountText" Grid.Row="1" Grid.Column="1" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Windows" Style="{StaticResource PropLabel}"/><TextBlock x:Name="WindowsText" Grid.Row="1" Grid.Column="3" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="2" Text="Architecture" Style="{StaticResource PropLabel}"/><TextBlock x:Name="ArchitectureText" Grid.Row="2" Grid.Column="1" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="Hardware" Style="{StaticResource PropLabel}"/><TextBlock x:Name="HardwareText" Grid.Row="2" Grid.Column="3" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="3" Text="Processor" Style="{StaticResource PropLabel}"/><TextBlock x:Name="ProcessorText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="4" Text="Memory" Style="{StaticResource PropLabel}"/><TextBlock x:Name="MemoryText" Grid.Row="4" Grid.Column="1" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="Domain / Entra" Style="{StaticResource PropLabel}"/><TextBlock x:Name="JoinText" Grid.Row="4" Grid.Column="3" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="5" Text="Secure Boot" Style="{StaticResource PropLabel}"/><TextBlock x:Name="SecureBootText" Grid.Row="5" Grid.Column="1" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="5" Grid.Column="2" Text="TPM" Style="{StaticResource PropLabel}"/><TextBlock x:Name="TpmText" Grid.Row="5" Grid.Column="3" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="6" Text="Encryption" Style="{StaticResource PropLabel}"/><TextBlock x:Name="BitLockerText" Grid.Row="6" Grid.Column="1" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="6" Grid.Column="2" Text="Protection" Style="{StaticResource PropLabel}"/><TextBlock x:Name="ProtectionText" Grid.Row="6" Grid.Column="3" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="7" Text="Protection product" Style="{StaticResource PropLabel}"/><TextBlock x:Name="ProtectionProductText" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource PropValue}"/>
          <TextBlock Grid.Row="8" Text="Last scan" Style="{StaticResource PropLabel}"/><TextBlock x:Name="LastScanText" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource PropValue}"/>
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Text="POSTURE SIGNALS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="2,0,0,7"/>
    <UniformGrid Columns="2" Margin="-5,0,-5,14">
      <Button Margin="5,0,5,10" Style="{StaticResource ActionNeutral}" MinHeight="82" Padding="12,9" Background="{DynamicResource BrushConflictSoft}" BorderBrush="{DynamicResource BrushConflict}" BorderThickness="1" Click="HighTile_Click">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="HIGH ATTENTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushConflict}" VerticalAlignment="Center"/>
          <TextBlock x:Name="HighCountText" Grid.Column="1" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushConflict}"/>
        </Grid>
      </Button>
      <Button Margin="5,0,5,10" Style="{StaticResource ActionNeutral}" MinHeight="82" Padding="12,9" Background="{DynamicResource BrushWarningSoft}" BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1" Click="ReviewTile_Click">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="REVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ReviewCountText" Grid.Column="1" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushWarning}"/>
        </Grid>
      </Button>
      <Button Margin="5,0" Style="{StaticResource ActionNeutral}" MinHeight="82" Padding="12,9" Background="{DynamicResource BrushSuccessSoft}" BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1" Click="ProtectionsTile_Click">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="PROTECTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ProtectedCountText" Grid.Column="1" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushSuccess}"/>
        </Grid>
      </Button>
      <Button Margin="5,0" Style="{StaticResource ActionNeutral}" MinHeight="82" Padding="12,9" Background="{DynamicResource BrushWarningSoft}" BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1" Click="ConflictsTile_Click">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="CONFLICTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ConflictCountText" Grid.Column="1" FontSize="28" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushWarning}"/>
        </Grid>
      </Button>
    </UniformGrid>

    <Border Style="{StaticResource PropertySheet}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="PRIORITY FINDINGS" FontWeight="Bold" FontSize="11"/>
        </Border>
        <StackPanel x:Name="FindingsList" Margin="0,2,0,2"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
