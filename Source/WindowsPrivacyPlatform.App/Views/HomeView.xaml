<UserControl x:Class="WindowsPrivacyPlatform.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Machine Overview" Style="{StaticResource SectionTitle}" />
    <TextBlock Text="Local platform identity and observed posture. Not a score."
               Style="{StaticResource SectionSubtitle}" />
    <Border Style="{StaticResource HeaderRule}" />

    <!-- Attention only when conflicts exist -->
    <Border x:Name="ConflictsCard" Style="{StaticResource CardConflict}" Visibility="Collapsed" Margin="0,0,0,14">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Attention" FontWeight="SemiBold" FontSize="13"
                     Foreground="{StaticResource BrushConflict}" />
          <TextBlock x:Name="ConflictsText" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
        </StackPanel>
        <Button x:Name="OpenConflictsBtn" Content="Open Conflicts" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
      </DockPanel>
    </Border>

    <!-- Identity — single property sheet -->
    <Border Style="{StaticResource PropertySheet}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="Identity" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Border>
        <Grid Margin="0,2,0,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Operating system" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="OsText" Grid.Column="1" Style="{StaticResource SheetValue}" FontWeight="SemiBold" />

          <TextBlock Grid.Row="1" Text="Architecture" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="ArchText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="2" Text="Device" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="DeviceText" Grid.Row="2" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="3" Text="Processor / memory" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="HwText" Grid.Row="3" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="4" Text="Domain / Entra" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="DomainText" Grid.Row="4" Grid.Column="1" Style="{StaticResource SheetValue}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Security posture — single property sheet -->
    <Border Style="{StaticResource PropertySheet}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="Security posture" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Border>
        <Grid Margin="0,2,0,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Secure Boot" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="SecureBootText" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="1" Text="TPM" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="TpmText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="2" Text="BitLocker" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="BitLockerText" Grid.Row="2" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="3" Text="Firewall" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="FirewallText" Grid.Row="3" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="4" Text="Defender" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="DefenderText" Grid.Row="4" Grid.Column="1" Style="{StaticResource SheetValue}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Scan meta — single property sheet -->
    <Border Style="{StaticResource PropertySheet}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="Scan" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Border>
        <TextBlock x:Name="ScanMetaText" Style="{StaticResource SheetValue}" Margin="12,8,12,10" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
