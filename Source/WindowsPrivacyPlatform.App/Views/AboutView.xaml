<UserControl x:Class="WindowsPrivacyPlatform.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
    <Border Style="{StaticResource HeaderRule}" />

    <Border Style="{StaticResource PropertyGroup}">
      <StackPanel>
        <TextBlock Text="Windows Privacy Platform 1.0" FontWeight="SemiBold" FontSize="13" />
        <TextBlock Style="{StaticResource ValueText}" Margin="0,4,0,0"
                   Text="Local read-only configuration knowledge explorer." />
      </StackPanel>
    </Border>

    <TextBlock Text="Mode" Style="{StaticResource GroupHeader}" />
    <Border Style="{StaticResource PropertyGroup}">
      <TextBlock Style="{StaticResource ValueText}"
                 Text="Inspect — active&#10;Modify — not available in 1.0" />
    </Border>

    <TextBlock Text="Safety" Style="{StaticResource GroupHeader}" />
    <Border Style="{StaticResource PropertyGroup}">
      <TextBlock Style="{StaticResource ValueText}"
                 Text="No writes · No elevation · No telemetry · Unknown preserved" />
    </Border>

    <TextBlock Text="Keyboard" Style="{StaticResource GroupHeader}" />
    <Border Style="{StaticResource PropertyGroup}">
      <TextBlock Style="{StaticResource ValueText}"
                 Text="F5 / Ctrl+R — scan&#10;Ctrl+F — search&#10;Esc — clear search" />
    </Border>

    <TextBlock Text="Project" Style="{StaticResource GroupHeader}" />
    <Border Style="{StaticResource PropertyGroup}">
      <TextBlock Style="{StaticResource ValueText}"
                 Text="https://github.com/HighLionNet/Windows-Privacy-Platform&#10;.NET 8 · Windows 11 · 2026-07-24" />
    </Border>
  </StackPanel>
</UserControl>
