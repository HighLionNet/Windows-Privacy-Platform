<UserControl x:Class="WindowsPrivacyPlatform.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="About Windows Privacy Platform" Style="{StaticResource SectionTitle}" />
    <TextBlock Style="{StaticResource SectionSubtitle}"
               Text="Version 1.0 — read-only Windows privacy and security knowledge explorer." />

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Philosophy" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="Understand first. Change later.&#10;&#10;This application discovers Windows configuration, explains effective layer precedence, and surfaces honest unknowns. It never writes to the registry, services, tasks, policies, or firewall. It never requests elevation. It never invents a security score." />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Architecture" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="Models → Core → Logging → KnowledgeBase → Validator → Scanner → CLI / App&#10;&#10;The GUI is a presentation host only. Collectors gather facts. KnowledgeBase owns meaning. Resolvers determine precedence. Presentation never contains Windows logic." />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Safety" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="No registry writes · No service changes · No task changes · No firewall changes · No elevation · No product telemetry · Unknown remains first-class" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="F5 or Ctrl+R — rescan&#10;Ctrl+F — focus search&#10;Enter (in search) — run search&#10;Esc — clear search focus" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Project" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="Repository: https://github.com/HighLionNet/Windows-Privacy-Platform&#10;Target: .NET 8 / Windows 11&#10;Application version: 1.0&#10;Knowledge catalog: 1.0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
