<UserControl x:Class="WindowsPrivacyPlatform.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
    <Border Style="{StaticResource HeaderRule}" />

    <Border Style="{StaticResource PropertySheet}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="Product" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Border>
        <Grid Margin="0,2,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Name" Style="{StaticResource SheetLabel}" />
          <TextBlock Grid.Column="1" Style="{StaticResource SheetValue}" FontWeight="SemiBold"
                     Text="Windows Privacy Platform 2.0" />

          <TextBlock Grid.Row="1" Text="Purpose" Style="{StaticResource SheetLabel}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetValue}"
                     Text="Evidence-driven Windows privacy &amp; configuration inspection and management" />

          <TextBlock Grid.Row="2" Text="Modes" Style="{StaticResource SheetLabel}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SheetValue}"
                     Text="Inspect (read-only) · Modify (UAC elevation required, verified writes only)" />

          <TextBlock Grid.Row="3" Text="Modification" Style="{StaticResource SheetLabel}" />
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SheetValue}"
                     Text="Explicit catalog-backed targets only. Every write is confirmed and independently verified." />

          <TextBlock Grid.Row="4" Text="Firewall" Style="{StaticResource SheetLabel}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SheetValue}"
                     Text="Observation only for rules. Selected profile/policy settings may be supported; rule management stays in native Windows tools." />

          <TextBlock Grid.Row="5" Text="Privacy" Style="{StaticResource SheetLabel}" />
          <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource SheetValue}"
                     Text="No telemetry. No network calls. Local audit logs only. Unknown is never turned into certainty." />
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource PropertySheet}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="Keyboard" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Border>
        <TextBlock Style="{StaticResource SheetValue}" Margin="12,8,12,10"
                   Text="F5 / Ctrl+R — scan&#10;Ctrl+F — search&#10;Esc — clear search" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource PropertySheet}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="Project" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Border>
        <TextBlock Style="{StaticResource SheetValue}" Margin="12,8,12,10"
                   Text="https://github.com/HighLionNet/Windows-Privacy-Platform&#10;.NET 8 · Windows 11 · v2.1" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
