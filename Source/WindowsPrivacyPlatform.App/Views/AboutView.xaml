<UserControl x:Class="WindowsPrivacyPlatform.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
    <Border Style="{StaticResource HeaderRule}" />

    <Border Style="{StaticResource PropertySheet}">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="Product identity" FontWeight="SemiBold" FontSize="12" />
        </Border>
        <Grid Margin="0,2,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Name" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="NameText" Grid.Column="1" Style="{StaticResource SheetValue}" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Text="Version" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="2" Text="Build" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="BuildText" Grid.Row="2" Grid.Column="1" Style="{StaticResource SheetValue}" FontFamily="Cascadia Mono, Consolas" />
          <TextBlock Grid.Row="3" Text="Publisher" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="CompanyText" Grid.Row="3" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="4" Text="Copyright" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="CopyrightText" Grid.Row="4" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="5" Text="Operating system" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="OsText" Grid.Row="5" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="6" Text="Executable" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="PathText" Grid.Row="6" Grid.Column="1" Style="{StaticResource SheetValue}" FontFamily="Cascadia Mono, Consolas" />
          <TextBlock Grid.Row="7" Text="Signing state" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="SigningText" Grid.Row="7" Grid.Column="1" Style="{StaticResource SheetValue}" />
          <TextBlock Grid.Row="8" Text="Executable SHA-256" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="HashText" Grid.Row="8" Grid.Column="1" Style="{StaticResource SheetValue}" FontFamily="Cascadia Mono, Consolas" />
          <TextBlock Grid.Row="9" Text="Repository" Style="{StaticResource SheetLabel}" />
          <Button x:Name="RepositoryButton" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left"
                  Style="{StaticResource LinkButton}" Margin="0,4,0,4" Click="RepositoryButton_Click" />
        </Grid>
      </StackPanel>
    </Border>

      <Border Style="{StaticResource PropertySheet}" Margin="0,0,0,12">
        <StackPanel>
          <Border Style="{StaticResource PropertySheetHeader}">
            <TextBlock Text="Keyboard" FontWeight="SemiBold" FontSize="12" />
          </Border>
          <TextBlock Style="{StaticResource SheetValue}" Margin="12,8,12,10"
                     Text="F5 or Ctrl+R   Scan&#10;Ctrl+F          Search&#10;Alt+Left/Right  Back / forward&#10;Esc             Clear search" />
        </StackPanel>
      </Border>
  </StackPanel>
</UserControl>
