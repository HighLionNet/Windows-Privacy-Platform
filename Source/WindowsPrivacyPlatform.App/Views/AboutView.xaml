<UserControl x:Class="WindowsPrivacyPlatform.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
    <TextBlock Style="{StaticResource SectionSubtitle}"
               Text="Windows Privacy Platform 1.0 — local read-only configuration knowledge explorer." />

    <Border Style="{StaticResource PropertyGroup}">
      <StackPanel>
        <TextBlock Text="Mode" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="Inspect (active) — discover and explain configuration without modification.&#10;Modify (future) — reserved for a controlled-change architecture. Not available in 1.0." />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource PropertyGroup}">
      <StackPanel>
        <TextBlock Text="Safety" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="No registry writes · No service / task / policy / firewall changes · No elevation · No product telemetry · Unknown remains first-class" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource PropertyGroup}">
      <StackPanel>
        <TextBlock Text="Architecture" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="Models → Core → Logging → KnowledgeBase → Validator → Scanner → CLI / App&#10;Presentation hosts contain no Windows configuration logic." />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource PropertyGroup}">
      <StackPanel>
        <TextBlock Text="Keyboard" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="F5 / Ctrl+R — rescan&#10;Ctrl+F — focus search&#10;Enter (search) — run search&#10;Esc — clear search" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource PropertyGroup}">
      <StackPanel>
        <TextBlock Text="Project" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource ValueText}"
                   Text="https://github.com/HighLionNet/Windows-Privacy-Platform&#10;.NET 8 / Windows 11 · Application 1.0 · Knowledge 1.0 · 2026-07-24" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
