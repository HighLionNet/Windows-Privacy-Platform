<UserControl x:Class="WindowsPrivacyPlatform.App.Views.SettingDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="DomainPathText" Style="{StaticResource SectionSubtitle}" />
    <StackPanel x:Name="BadgeRow" Orientation="Horizontal" Margin="0,0,0,6" />
    <Border Style="{StaticResource HeaderRule}" />

    <!-- Primary configuration state — property sheet primary block -->
    <Border Style="{StaticResource CardAccent}">
      <StackPanel>
        <TextBlock Text="Current configuration" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Raw / current" Style="{StaticResource PropLabel}" />
          <TextBlock x:Name="ObservedText" Grid.Column="1" Style="{StaticResource PrimaryValue}" />
          <TextBlock Grid.Row="1" Text="Effective" Style="{StaticResource PropLabel}" />
          <TextBlock x:Name="EffectiveText" Grid.Row="1" Grid.Column="1" Style="{StaticResource PropValue}" />
          <TextBlock Grid.Row="2" Text="Confidence" Style="{StaticResource PropLabel}" />
          <TextBlock x:Name="ConfidenceText" Grid.Row="2" Grid.Column="1" Style="{StaticResource PropValue}" />
          <TextBlock Grid.Row="3" Text="Reason" Style="{StaticResource PropLabel}" />
          <TextBlock x:Name="ReasonText" Grid.Row="3" Grid.Column="1" Style="{StaticResource PropValue}"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Text="What this controls" Style="{StaticResource GroupHeader}" Margin="0,6,0,4" />
    <Border Style="{StaticResource PropertyGroup}">
      <TextBlock x:Name="WhatText" Style="{StaticResource ValueText}" />
    </Border>

    <TextBlock Text="Why Windows has this" Style="{StaticResource GroupHeader}" Margin="0,2,0,4" />
    <Border Style="{StaticResource PropertyGroup}">
      <TextBlock x:Name="WhyText" Style="{StaticResource ValueText}" />
    </Border>

    <TextBlock Text="Impact" Style="{StaticResource GroupHeader}" Margin="0,2,0,4" />
    <Border Style="{StaticResource PropertyGroup}">
      <StackPanel>
        <TextBlock x:Name="ImpactText" Style="{StaticResource ValueText}" />
        <Expander Header="User · enterprise · misconceptions" Style="{StaticResource DetailExpander}" IsExpanded="False" Margin="0,6,0,0">
          <StackPanel Margin="0,4,0,0">
            <TextBlock x:Name="UserImpactText" Style="{StaticResource ValueText}" />
            <TextBlock x:Name="EnterpriseText" Style="{StaticResource ValueText}" Margin="0,4,0,0" />
            <TextBlock x:Name="MisconceptionText" Style="{StaticResource ValueText}" Margin="0,4,0,0"
                       Foreground="{StaticResource BrushWarning}" />
            <TextBlock x:Name="UnknownsText" Style="{StaticResource ValueText}" Margin="0,4,0,0"
                       Foreground="{StaticResource BrushTextMuted}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <Expander Header="Observed layers (evidence)" Style="{StaticResource DetailExpander}" IsExpanded="False" Margin="0,4,0,0">
      <Border Style="{StaticResource PropertyGroup}" Margin="0,4,0,0">
        <ItemsControl x:Name="LayersList" />
      </Border>
    </Expander>

    <TextBlock Text="Related settings" Style="{StaticResource GroupHeader}" Margin="0,6,0,4" />
    <Border Style="{StaticResource ListContainer}">
      <ItemsControl x:Name="RelatedList" />
    </Border>

    <Border Style="{StaticResource SectionRule}" />
    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
      <TextBlock x:Name="ObjectIdText" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
      <Button x:Name="CopyIdButton" Content="Copy ObjectId" Style="{StaticResource LinkButton}"
              Margin="10,0,0,0" Click="CopyIdButton_Click"
              ToolTip="Copy ObjectId to clipboard" />
    </StackPanel>
  </StackPanel>
</UserControl>
