<UserControl x:Class="WindowsPrivacyPlatform.App.Views.SettingDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
    <DockPanel LastChildFill="True">
      <Border x:Name="AccessBadge" DockPanel.Dock="Right" Style="{StaticResource BadgeSuccess}" VerticalAlignment="Center">
        <TextBlock x:Name="AccessBadgeText" FontSize="9" FontWeight="SemiBold" />
      </Border>
      <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
        <TextBlock x:Name="DomainPathText" Style="{StaticResource SectionSubtitle}" />
      </StackPanel>
    </DockPanel>
    <Border Style="{StaticResource HeaderRule}" />

    <Border x:Name="ApplicabilityPanel" Style="{StaticResource Card}" Background="{StaticResource BrushWarningSoft}"
            BorderBrush="{StaticResource BrushWarning}" Visibility="Collapsed" Margin="0,0,0,12">
      <TextBlock x:Name="ApplicabilityText" TextWrapping="Wrap" />
    </Border>

    <Border Style="{StaticResource PropertySheet}" Margin="0,0,0,14">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}"><TextBlock Text="Current policy" FontWeight="SemiBold" /></Border>
        <Grid Margin="0,5,0,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="Observed" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="ObservedText" Grid.Column="1" Style="{StaticResource SheetValue}" FontFamily="Cascadia Mono, Consolas" />
          <TextBlock Grid.Row="1" Text="Effective" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="EffectiveText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetValue}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" />
          <TextBlock Grid.Row="2" Text="Source" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="SourceText" Grid.Row="2" Grid.Column="1" Style="{StaticResource SheetValue}" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="21" Margin="2,0,2,12" />

    <Border Padding="11,9" Background="{StaticResource BrushBgHeader}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="REGISTRY / POLICY PATH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" />
        <TextBlock x:Name="TechnicalLocationText" Margin="0,4,0,0" FontSize="11" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel x:Name="OptionsPanel">
      <TextBlock Text="Available choices" Style="{StaticResource GroupHeader}" Margin="0,0,0,7" />
      <ItemsControl x:Name="OptionsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="2,0,2,7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" />
              <TextBlock Grid.Column="2" Text="{Binding RawValue}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource BrushTextMuted}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
