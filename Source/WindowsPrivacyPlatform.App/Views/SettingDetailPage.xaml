<UserControl x:Class="WindowsPrivacyPlatform.App.Views.SettingDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="DomainPathText" Style="{StaticResource SectionSubtitle}" />

    <StackPanel x:Name="BadgeRow" Orientation="Horizontal" Margin="0,0,0,12" />

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="What this is" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="WhatText" Style="{StaticResource ValueText}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Why it matters" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="WhyText" Style="{StaticResource ValueText}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Observation" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="ObservedText" Style="{StaticResource ValueText}" />
        <TextBlock x:Name="EffectiveText" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
        <TextBlock x:Name="ConfidenceText" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
        <TextBlock x:Name="ReasonText" Style="{StaticResource ValueText}" Margin="0,6,0,0"
                   Foreground="{StaticResource BrushTextSecondary}" />
        <ItemsControl x:Name="LayersList" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Impact and guidance" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="ImpactText" Style="{StaticResource ValueText}" />
        <TextBlock x:Name="UserImpactText" Style="{StaticResource ValueText}" Margin="0,8,0,0" />
        <TextBlock x:Name="EnterpriseText" Style="{StaticResource ValueText}" Margin="0,8,0,0" />
        <TextBlock x:Name="MisconceptionText" Style="{StaticResource ValueText}" Margin="0,8,0,0"
                   Foreground="{StaticResource BrushWarning}" />
        <TextBlock x:Name="UnknownsText" Style="{StaticResource ValueText}" Margin="0,8,0,0"
                   Foreground="{StaticResource BrushTextMuted}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Related settings" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ItemsControl x:Name="RelatedList" />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock x:Name="ObjectIdText" Style="{StaticResource LabelMuted}" VerticalAlignment="Center" />
      <Button x:Name="CopyIdButton" Content="Copy ObjectId" Style="{StaticResource LinkButton}"
              Margin="12,0,0,0" Click="CopyIdButton_Click"
              ToolTip="Copy ObjectId to the clipboard" />
    </StackPanel>
  </StackPanel>
</UserControl>
