<UserControl x:Class="WindowsPrivacyPlatform.App.Views.SettingDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>

    <!-- Page header -->
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="DomainPathText" Style="{StaticResource SectionSubtitle}" />
    <StackPanel x:Name="BadgeRow" Orientation="Horizontal" Margin="0,8,0,6" />
    <Border Style="{StaticResource HeaderRule}" />

    <!-- Primary effective state callout -->
    <Border Style="{StaticResource PropertySheet}" Margin="0,0,0,14">
      <StackPanel>
        <Border Style="{StaticResource PropertySheetHeader}">
          <TextBlock Text="Effective state" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Border>
        <Grid Margin="0,4,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Effective" Style="{StaticResource SheetLabel}" FontWeight="SemiBold" />
          <TextBlock x:Name="EffectiveText" Grid.Column="1" Style="{StaticResource SheetValue}"
                     FontSize="15" FontWeight="SemiBold" />

          <TextBlock Grid.Row="1" Text="Observed" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="ObservedText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="2" Text="Source" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="SourceText" Grid.Row="2" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="3" Text="Confidence" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="ConfidenceText" Grid.Row="3" Grid.Column="1" Style="{StaticResource SheetValue}" />

          <TextBlock Grid.Row="4" Text="Reason" Style="{StaticResource SheetLabel}" />
          <TextBlock x:Name="ReasonText" Grid.Row="4" Grid.Column="1" Style="{StaticResource SheetValue}"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Short summary always visible -->
    <TextBlock Text="Summary" Style="{StaticResource GroupHeader}" Margin="0,0,0,4" />
    <TextBlock x:Name="WhatText" Style="{StaticResource ValueText}" Margin="0,0,0,4" />

    <!-- Progressive disclosure: technical and knowledge sections collapsed by default -->
    <Expander Header="Why this exists and impact" Style="{StaticResource DetailExpander}" IsExpanded="False">
      <StackPanel Margin="4,8,0,4">
        <TextBlock Text="Why Windows has this" FontWeight="SemiBold" FontSize="12"
                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
        <TextBlock x:Name="WhyText" Style="{StaticResource ValueText}" Margin="0,0,0,10" />

        <TextBlock Text="Impact" FontWeight="SemiBold" FontSize="12"
                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
        <TextBlock x:Name="ImpactText" Style="{StaticResource ValueText}" Margin="0,0,0,4" />
      </StackPanel>
    </Expander>

    <Expander Header="User · enterprise · misconceptions · limits" Style="{StaticResource DetailExpander}" IsExpanded="False">
      <StackPanel Margin="4,8,0,4">
        <TextBlock x:Name="UserImpactText" Style="{StaticResource ValueText}" />
        <TextBlock x:Name="EnterpriseText" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
        <TextBlock x:Name="MisconceptionText" Style="{StaticResource ValueText}" Margin="0,6,0,0"
                   Foreground="{StaticResource BrushWarning}" />
        <TextBlock x:Name="UnknownsText" Style="{StaticResource ValueText}" Margin="0,6,0,0"
                   Foreground="{StaticResource BrushTextMuted}" />
      </StackPanel>
    </Expander>

    <Expander Header="Observed layers (evidence)" Style="{StaticResource DetailExpander}" IsExpanded="False">
      <ItemsControl x:Name="LayersList" Margin="4,8,0,4" />
    </Expander>

    <Expander Header="Related settings" Style="{StaticResource DetailExpander}" IsExpanded="False">
      <Border Style="{StaticResource ListContainer}" Margin="0,8,0,0">
        <ItemsControl x:Name="RelatedList" />
      </Border>
    </Expander>

    <Border Style="{StaticResource SectionRule}" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
      <TextBlock x:Name="ObjectIdText" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
      <Button x:Name="CopyIdButton" Content="Copy ObjectId" Style="{StaticResource LinkButton}"
              Margin="12,0,0,0" Click="CopyIdButton_Click"
              ToolTip="Copy ObjectId to clipboard" />
    </StackPanel>
  </StackPanel>
</UserControl>
