<UserControl x:Class="WindowsPrivacyPlatform.App.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock Text="Services" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="SubtitleText" Style="{StaticResource SectionSubtitle}" />
    <TextBlock Text="Read-only service evidence. This page never starts, stops, enables, disables, or deletes a service."
               Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" />
    <Border Style="{StaticResource HeaderRule}" />
    <Border Style="{StaticResource ListContainer}" Padding="12" Margin="0,0,0,10">
      <WrapPanel>
        <TextBox x:Name="SearchBox" Width="230" Height="30" Padding="8,4" Margin="0,0,8,8"
                 TextChanged="FilterChanged" ToolTip="Filter by service name, display name, description, account, path, publisher, signature, or tags" />
        <ComboBox x:Name="StateBox" Width="130" Height="30" Margin="0,0,8,8" SelectionChanged="FilterChanged">
          <ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="Running"/><ComboBoxItem Content="Stopped"/><ComboBoxItem Content="Paused"/>
        </ComboBox>
        <ComboBox x:Name="StartupBox" Width="140" Height="30" Margin="0,0,8,8" SelectionChanged="FilterChanged">
          <ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Manual"/><ComboBoxItem Content="Disabled"/>
        </ComboBox>
        <ComboBox x:Name="PublisherBox" Width="155" Height="30" Margin="0,0,8,8" SelectionChanged="FilterChanged">
          <ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="Microsoft"/><ComboBoxItem Content="Non-Microsoft"/><ComboBoxItem Content="Unknown publisher"/>
        </ComboBox>
        <ComboBox x:Name="IssueBox" Width="230" Height="30" Margin="0,0,8,8" SelectionChanged="FilterChanged">
          <ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="No issue observed"/><ComboBoxItem Content="Automatic service is stopped"/>
          <ComboBoxItem Content="Executable missing or inaccessible"/><ComboBoxItem Content="Dependency issue observed"/>
          <ComboBoxItem Content="Configuration issue observed"/><ComboBoxItem Content="Access denied"/><ComboBoxItem Content="Unable to verify"/>
        </ComboBox>
      </WrapPanel>
    </Border>
    <StackPanel x:Name="ServiceCards" />
  </StackPanel>
</UserControl>
