<UserControl x:Class="WindowsPrivacyPlatform.App.Views.ScheduledTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="SubtitleText" TextWrapping="Wrap"/>
      <Border Style="{StaticResource HeaderRule}"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource FilterBar}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="SEARCH" Style="{StaticResource FilterLabel}"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search scheduled tasks"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Style="{StaticResource ResultsDivider}"><Border Width="132" Background="{DynamicResource BrushAccent}" HorizontalAlignment="Left"/></Grid>
    <Border Grid.Row="3" Style="{StaticResource ListContainer}" Margin="0">
      <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,9" Background="{DynamicResource BrushBgCard}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Path}" Margin="0,3,12,0" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding ControlsVisibility}">
                  <Button Content="Enable" Tag="{Binding Path}" CommandParameter="Enable" Style="{StaticResource ActionSuccess}" Margin="0,0,7,0" Click="TaskAction_Click"/>
                  <Button Content="Disable" Tag="{Binding Path}" CommandParameter="Disable" Style="{StaticResource ActionDanger}" Click="TaskAction_Click"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
