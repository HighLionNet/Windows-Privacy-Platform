<UserControl x:Class="WindowsPrivacyPlatform.App.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="SubtitleText" Style="{StaticResource SectionSubtitle}" />
    <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" TextWrapping="Wrap"
               Foreground="{StaticResource BrushTextPrimary}" FontSize="12" />
    <TextBlock x:Name="WhyText" Margin="0,3,0,0" TextWrapping="Wrap"
               Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
    <Border Style="{StaticResource HeaderRule}" />
    <Border Style="{StaticResource ListContainer}" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <DockPanel>
          <Button x:Name="ApplyPendingButton" DockPanel.Dock="Right" Content="Apply pending (0)"
                  Style="{StaticResource PrimaryButton}" Click="ApplyPending_Click" IsEnabled="False"
                  ToolTip="Review and apply all pending values in one confirmation" />
          <TextBox x:Name="FilterBox" MinWidth="260" Height="30" Padding="8,4"
                   VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"
                   ToolTip="Filter this category by title, description, state, or scope" />
        </DockPanel>
        <WrapPanel x:Name="SummaryPanel" Margin="0,10,0,0" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource BrushTextMuted}"
                   Text="Choose proposed values, then apply the pending batch. Selection never writes immediately." />
      </StackPanel>
    </Border>
    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="4,8"
               Foreground="{StaticResource BrushTextMuted}" Text="No settings match this category filter." />
    <StackPanel x:Name="SettingsList" />
  </StackPanel>
</UserControl>
