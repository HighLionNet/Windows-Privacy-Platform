<UserControl x:Class="WindowsPrivacyPlatform.App.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="SubtitleText" Visibility="Collapsed"/>
    <TextBlock x:Name="DescriptionText" Visibility="Collapsed"/>
    <Border Style="{StaticResource HeaderRule}"/>
    <Border Style="{StaticResource FilterBar}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="SEARCH" Style="{StaticResource FilterLabel}" Margin="0,0,8,8"/>
            <TextBox x:Name="FilterBox" Width="280" Height="34" VerticalContentAlignment="Center" Margin="0,0,14,8" TextChanged="FilterChanged" AutomationProperties.Name="Search settings"/>
            <TextBlock Text="STATE" Style="{StaticResource FilterLabel}" Margin="0,0,8,8"/>
            <ComboBox x:Name="StateBox" Width="190" Height="34" Margin="0,0,8,8" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter by state">
              <ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="Configured"/><ComboBoxItem Content="Not configured"/>
              <ComboBoxItem Content="Not observed"/><ComboBoxItem Content="Unknown"/><ComboBoxItem Content="Not on this PC"/>
              <ComboBoxItem Content="Access denied"/><ComboBoxItem Content="Stale"/><ComboBoxItem Content="Error"/>
            </ComboBox>
          </WrapPanel>
          <WrapPanel x:Name="SummaryPanel"/>
          <TextBlock x:Name="ModeStatusText" Visibility="Collapsed"/>
        </StackPanel>
        <Button x:Name="ApplyPendingButton" Grid.Column="1" Content="Apply (0)" Style="{StaticResource ActionPrimary}"
                Margin="16,0,0,0" MinWidth="128" VerticalAlignment="Top" Click="ApplyPending_Click" IsEnabled="False"/>
      </Grid>
    </Border>
    <Grid Style="{StaticResource ResultsDivider}">
      <Border Width="132" Background="{DynamicResource BrushAccent}" HorizontalAlignment="Left"/>
    </Grid>
    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="4,8" Foreground="{DynamicResource BrushTextMuted}" Text="No settings match these filters."/>
    <StackPanel x:Name="SettingsList"/>
  </StackPanel>
</UserControl>
