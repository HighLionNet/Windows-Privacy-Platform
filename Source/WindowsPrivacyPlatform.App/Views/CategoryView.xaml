<UserControl x:Class="WindowsPrivacyPlatform.App.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch">
  <StackPanel>
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="SubtitleText" Style="{StaticResource SectionSubtitle}"/>
    <TextBlock x:Name="DescriptionText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
    <Border Style="{StaticResource HeaderRule}"/>
    <Border Style="{StaticResource ListContainer}" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="Search:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,8"/>
            <TextBox x:Name="FilterBox" Width="280" Height="34" VerticalContentAlignment="Center" Margin="0,0,14,8" TextChanged="FilterChanged"/>
            <TextBlock Text="State:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,8"/>
            <ComboBox x:Name="StateBox" Width="170" Height="34" Margin="0,0,8,8" SelectionChanged="FilterChanged">
              <ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="Configured"/><ComboBoxItem Content="Not configured"/>
              <ComboBoxItem Content="Not observed"/><ComboBoxItem Content="Unknown"/><ComboBoxItem Content="Unsupported"/>
              <ComboBoxItem Content="Access denied"/><ComboBoxItem Content="Stale"/><ComboBoxItem Content="Error"/>
            </ComboBox>
          </WrapPanel>
          <WrapPanel x:Name="SummaryPanel"/>
          <TextBlock Margin="0,5,0,0" Text="Choices are staged here. Nothing changes until Apply is confirmed."
                     Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
        </StackPanel>
        <Button x:Name="ApplyPendingButton" Grid.Column="1" Content="Apply (0)" Style="{StaticResource ActionPrimary}"
                Margin="16,0,0,0" MinWidth="128" VerticalAlignment="Top" Click="ApplyPending_Click" IsEnabled="False"/>
      </Grid>
    </Border>
    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="4,8" Foreground="{DynamicResource BrushTextMuted}" Text="No settings match these filters."/>
    <StackPanel x:Name="SettingsList"/>
  </StackPanel>
</UserControl>
