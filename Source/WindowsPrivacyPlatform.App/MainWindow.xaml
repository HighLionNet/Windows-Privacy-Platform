<Window x:Class="WindowsPrivacyPlatform.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Privacy Platform"
        Height="860" Width="1320"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <DockPanel>

    <!-- Top chrome -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgContent}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Windows Privacy Platform" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"
                     ToolTip="Local read-only configuration knowledge explorer" />
          <Border Margin="12,0,0,0" Padding="6,2" Background="{StaticResource BrushAccentSoft}"
                  BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Mode" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="ModeCombo" Width="96" Height="22"
                        VerticalContentAlignment="Center" SelectedIndex="0"
                        FontSize="11"
                        ToolTip="Inspect is active. Modify is a future scaffold and remains disabled."
                        SelectionChanged="ModeCombo_SelectionChanged">
                <ComboBoxItem Content="Inspect" IsSelected="True" />
                <ComboBoxItem Content="Modify" IsEnabled="False" />
              </ComboBox>
            </StackPanel>
          </Border>
          <TextBlock x:Name="VersionLabel" Text="v1.0" Margin="10,0,0,0"
                     Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" FontSize="11" />
          <TextBlock x:Name="ScanTimeLabel" Text="" Margin="10,0,0,0"
                     Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" FontSize="11"
                     ToolTip="Last successful scan (UTC)" />
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Column="1" Width="280" Height="26"
                 VerticalContentAlignment="Center" Padding="6,0"
                 Margin="0,0,8,0"
                 ToolTip="Search ObjectId, name, description, domain (Enter). Ctrl+F focuses. Esc clears."
                 KeyDown="SearchBox_KeyDown" />

        <Button x:Name="ScanButton" Grid.Column="2" Content="Scan"
                Style="{StaticResource PrimaryButton}" Click="ScanButton_Click"
                MinWidth="72"
                ToolTip="Run read-only discovery (F5 / Ctrl+R)" />
      </Grid>
    </Border>

    <!-- Status bar — operational facts only -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBgSidebar}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready"
                   Foreground="{StaticResource BrushTextSecondary}" FontSize="11"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock x:Name="CatalogCountLabel" Text="Objects: —" Margin="8,0,0,0"
                     Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
          <TextBlock x:Name="ConflictCountLabel" Text="Conflicts: —" Margin="10,0,0,0"
                     Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
          <TextBlock x:Name="ValidationLabel" Text="Validation: —" Margin="10,0,0,0"
                     Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
          <TextBlock Text="Inspect · Read-only" Margin="12,0,0,0"
                     Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Navigation — hierarchical console tree -->
      <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}"
              BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                  Padding="6,6">
            <Button Content="☰" Width="28" Height="24" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}"
                    Click="ToggleSidebar_Click" ToolTip="Collapse or expand navigation" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="NavScroll">
            <StackPanel Margin="0,4,0,10" x:Name="NavPanel">
              <TextBlock Text="MACHINE" Style="{StaticResource SidebarGroupLabel}" Margin="12,2,8,2" />
              <Button x:Name="NavHome" Content="Machine Overview" Style="{StaticResource SidebarButtonSelected}"
                      Click="Nav_Click" Tag="home"
                      ToolTip="Device context and observation summary" />

              <Border Style="{StaticResource SectionRule}" Margin="12,6,12,2" />
              <TextBlock Text="PRIVACY" Style="{StaticResource SidebarGroupLabel}" />
              <Button Content="App permissions" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:ConsentStore" />
              <Button Content="App policy overrides" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:AppPrivacy" />
              <Button Content="Telemetry" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Telemetry" />
              <Button Content="Advertising" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Advertising" />
              <Button Content="Location" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Location" />
              <Button Content="Activity History" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:ActivityHistory" />
              <Button Content="Cloud content" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:CloudContent" />

              <Border Style="{StaticResource SectionRule}" Margin="12,6,12,2" />
              <TextBlock Text="SECURITY" Style="{StaticResource SidebarGroupLabel}" />
              <Button Content="Microsoft Defender" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Defender" />
              <Button Content="Firewall" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Firewall" />
              <Button Content="Biometrics" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Biometrics" />

              <Border Style="{StaticResource SectionRule}" Margin="12,6,12,2" />
              <TextBlock Text="WINDOWS" Style="{StaticResource SidebarGroupLabel}" />
              <Button Content="Windows Update" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:WindowsUpdate" />
              <Button Content="Search" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Search" />
              <Button Content="Speech" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Speech" />
              <Button Content="Device" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Device" />

              <Border Style="{StaticResource SectionRule}" Margin="12,6,12,2" />
              <TextBlock Text="APPLICATIONS" Style="{StaticResource SidebarGroupLabel}" />
              <Button Content="Microsoft Edge" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Edge" />

              <Border Style="{StaticResource SectionRule}" Margin="12,6,12,2" />
              <TextBlock Text="KNOWLEDGE" Style="{StaticResource SidebarGroupLabel}" />
              <Button x:Name="NavConflicts" Content="Conflicts" Style="{StaticResource SidebarButton}"
                      Click="Nav_Click" Tag="conflicts"
                      ToolTip="Settings with observed layer disagreements" />
              <Button x:Name="NavKnowledge" Content="Knowledge Explorer" Style="{StaticResource SidebarButton}"
                      Click="Nav_Click" Tag="knowledge"
                      ToolTip="Browse the curated catalog" />

              <Border Style="{StaticResource SectionRule}" Margin="12,6,12,2" />
              <TextBlock Text="ABOUT" Style="{StaticResource SidebarGroupLabel}" />
              <Button Content="About" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="about"
                      ToolTip="Version, safety model, shortcuts" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Content + breadcrumb — full workspace width -->
      <DockPanel Grid.Column="1" Background="{StaticResource BrushBgWindow}">
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgContent}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="12,5">
          <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,14,14"
                      HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="ContentHost" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
