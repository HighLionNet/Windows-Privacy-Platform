<Window x:Class="WindowsPrivacyPlatform.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsPrivacyPlatform.App"
        Title="" Height="860" Width="1320" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <Window.Resources>
    <local:SubtractConverter x:Key="ContentWidthConverter" Amount="40" />
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{DynamicResource BrushBgMenu}"
          BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,0,0,1">
      <MenuItem Header="_File"><MenuItem Header="_Scan" InputGestureText="F5" Click="MenuScan_Click"/><Separator/><MenuItem Header="E_xit" Click="MenuExit_Click"/></MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Overview" Click="MenuHome_Click"/><MenuItem Header="_System Explorer" Click="MenuInventory_Click"/>
        <MenuItem Header="_Services (read-only)" Click="MenuServices_Click"/><Separator/>
        <MenuItem Header="_Back" InputGestureText="Alt+Left" Click="BackButton_Click"/>
        <MenuItem Header="_Forward" InputGestureText="Alt+Right" Click="ForwardButton_Click"/>
        <Separator/><MenuItem Header="Toggle _Navigation Pane" Click="ToggleSidebar_Click"/>
        <MenuItem Header="_Refresh" InputGestureText="Ctrl+R" Click="MenuScan_Click"/>
      </MenuItem>
      <MenuItem Header="_Settings" Click="MenuSettings_Click" />
      <MenuItem Header="_Tools"><MenuItem Header="_Search…" InputGestureText="Ctrl+F" Click="MenuSearch_Click"/></MenuItem>
      <MenuItem Header="_Help"><MenuItem Header="_About" Click="MenuAbout_Click"/></MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="{DynamicResource BrushHeaderChrome}"
            BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="230">
          <Image Width="36" Height="36" Source="Assets/WindowsPrivacyPlatform.png" Stretch="Uniform" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ProductNameText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushTextPrimary}"/>
              <TextBlock x:Name="HeaderVersionText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="ScanTimeLabel" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
          <Button x:Name="BackButton" Content="←" Width="38" Style="{StaticResource ActionNeutral}" Padding="0" ToolTip="Back (Alt+Left)" Click="BackButton_Click" IsEnabled="False"/>
          <Button x:Name="ForwardButton" Content="→" Width="38" Style="{StaticResource ActionNeutral}" Padding="0" Margin="6,0,0,0" ToolTip="Forward (Alt+Right)" Click="ForwardButton_Click" IsEnabled="False"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="Mode:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}"/>
          <ComboBox x:Name="ModeCombo" Width="116" Height="34" SelectedIndex="0" VerticalContentAlignment="Center"
                    SelectionChanged="ModeCombo_SelectionChanged" DropDownOpened="ModeCombo_DropDownOpened">
            <ComboBoxItem Content="View-only" IsSelected="True"/><ComboBoxItem Content="Admin"/>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBlock Text="Search:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}"/>
          <TextBox x:Name="SearchBox" Width="180" Height="34" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown" ToolTip="Enter to search. Esc clears."/>
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ActionNeutral}" Width="40" Padding="0" Margin="0,0,6,0" ToolTip="App Settings" Click="SettingsButton_Click">
            <Viewbox Width="18" Height="18"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrushTextPrimary}"/></Viewbox>
          </Button>
          <Button x:Name="CancelScanButton" Content="Cancel" Style="{StaticResource ActionNeutral}" Click="CancelScanButton_Click" MinWidth="72" Margin="0,0,6,0" Visibility="Collapsed"/>
          <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource ActionPrimary}" Click="ScanButton_Click" MinWidth="76"/>
        </StackPanel>
        <ProgressBar x:Name="ScanProgress" Grid.Column="0" Grid.ColumnSpan="5" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-8" Visibility="Collapsed"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushBgMenu}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock x:Name="CatalogCountLabel" Text="Settings: —" Margin="8,0,0,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
          <TextBlock x:Name="ConflictCountLabel" Text="Explorer: —" Margin="12,0,0,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
          <TextBlock x:Name="FooterVersionText" Margin="14,0,0,0" Foreground="{DynamicResource BrushAccent}" FontSize="11" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="252" MinWidth="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource BrushSidebarChrome}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" x:Name="NavScroll">
          <StackPanel Margin="0,6,0,10" x:Name="NavPanel">
            <TextBlock Text="HUB" Style="{StaticResource SidebarGroupLabel}" Margin="12,8,8,4"/>
            <Button x:Name="NavHome" Content="Overview" Style="{StaticResource SidebarButtonSelected}" Click="Nav_Click" Tag="home"/>
            <Button x:Name="NavInventory" Content="System Explorer" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="inventory"/>
            <Button x:Name="NavServices" Content="Services" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="services"/>
            <Border Style="{StaticResource SectionRule}" Margin="10,8,10,2"/>
            <TextBlock Text="PRIVACY" Style="{StaticResource SidebarGroupLabel}" Foreground="{DynamicResource BrushDomainPrivacy}"/>
            <Button Content="App permissions" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:ConsentStore"/>
            <Button Content="App policy controls" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:AppPrivacy"/>
            <Button Content="Diagnostics &amp; feedback" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Telemetry"/>
            <Button Content="Location" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Location"/>
            <Button Content="Personalization" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:CloudContent"/>
            <Button Content="Advertising" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Advertising"/>
            <Button Content="Activity" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:ActivityHistory"/>
            <Button Content="Device privacy" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Device"/>
            <Button Content="Speech" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Speech"/>
            <Button Content="Clipboard" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Other"/>
            <Border Style="{StaticResource SectionRule}" Margin="10,8,10,2"/>
            <TextBlock Text="SECURITY" Style="{StaticResource SidebarGroupLabel}" Foreground="{DynamicResource BrushDomainSecurity}"/>
            <Button Content="Microsoft Defender" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Defender"/>
            <Button Content="Firewall" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Firewall"/>
            <Button Content="Biometrics" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Biometrics"/>
            <Button Content="Local security" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:LocalSecurity"/>
            <Button Content="Network security" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Network"/>
            <Button Content="Remote access" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:RemoteAccess"/>
            <Border Style="{StaticResource SectionRule}" Margin="10,8,10,2"/>
            <TextBlock Text="WINDOWS APPS" Style="{StaticResource SidebarGroupLabel}" Foreground="{DynamicResource BrushDomainApps}"/>
            <Button Content="Copilot" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Copilot"/>
            <Button Content="Recall &amp; Click to Do" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Recall"/>
            <Button Content="Search" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Search"/>
            <Button Content="Microsoft Edge" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Edge"/>
            <Button Content="OneDrive" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:OneDrive"/>
            <Button Content="Widgets" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Widgets"/>
            <Border Style="{StaticResource SectionRule}" Margin="10,8,10,2"/>
            <TextBlock Text="APP" Style="{StaticResource SidebarGroupLabel}"/>
            <Button Content="Settings" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="settings"/>
            <Button Content="About" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="about"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <DockPanel Grid.Column="1" Background="{DynamicResource BrushBgWindow}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrushBgHeader}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,0,0,1" Padding="16,6">
          <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal"/>
        </Border>
        <Grid>
          <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False" Padding="18,14,18,18" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" ScrollChanged="ContentScroll_ScrollChanged">
            <ContentControl x:Name="ContentHost"
                            Width="{Binding ActualWidth, ElementName=ContentScroll, Converter={StaticResource ContentWidthConverter}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          </ScrollViewer>
          <Button x:Name="BackToTopButton" Content="↑  Back to top" Style="{StaticResource ActionNeutral}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Visibility="Collapsed"
                  Click="BackToTopButton_Click"/>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
