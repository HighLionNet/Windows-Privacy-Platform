<Window x:Class="WindowsPrivacyPlatform.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WindowsPrivacyPlatform.App.Behaviors"
        Title="Windows Privacy Platform"
        Height="860" Width="1320"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <DockPanel>

    <Menu DockPanel.Dock="Top" Background="{StaticResource BrushBgMenu}"
          BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="0,0,0,1">
      <MenuItem Header="_File">
        <MenuItem Header="_Scan" InputGestureText="F5" Click="MenuScan_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="MenuExit_Click" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Machine Overview" Click="MenuHome_Click" />
        <MenuItem Header="_Conflicts" Click="MenuConflicts_Click" />
        <MenuItem Header="_Knowledge Explorer" Click="MenuKnowledge_Click" />
        <Separator />
        <MenuItem Header="Toggle _Navigation Pane" Click="ToggleSidebar_Click" />
        <MenuItem Header="_Refresh" InputGestureText="Ctrl+R" Click="MenuScan_Click" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Search…" InputGestureText="Ctrl+F" Click="MenuSearch_Click" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Windows Privacy Platform" Click="MenuAbout_Click" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgContent}"
            BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" Background="{StaticResource BrushAccent}" Margin="0,0,12,0"
                  VerticalAlignment="Center">
            <TextBlock Text="WPP" Foreground="White" FontWeight="Bold" FontSize="9"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Windows Privacy Platform" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock x:Name="ScanTimeLabel" Text="" FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}" />
          </StackPanel>
          <TextBlock Text="v2.1" Margin="14,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource BrushTextMuted}" FontSize="12" FontWeight="SemiBold" />
          <Border Margin="16,0,0,0" Padding="8,3" BorderBrush="{StaticResource BrushBorderStrong}"
                  BorderThickness="1" Background="{StaticResource BrushBgHeader}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Mode" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="ModeCombo" Width="96" Height="22"
                        VerticalContentAlignment="Center" SelectedIndex="0" FontSize="11"
                        SelectionChanged="ModeCombo_SelectionChanged">
                <ComboBoxItem Content="Inspect" IsSelected="True" />
                <ComboBoxItem Content="Modify" />
              </ComboBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Column="1" Width="280" Height="28"
                 VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"
                 ToolTip="Search (Ctrl+F). Enter to run. Esc clears."
                 KeyDown="SearchBox_KeyDown" />

        <Button x:Name="ScanButton" Grid.Column="2" Content="Scan"
                Style="{StaticResource PrimaryButton}" Click="ScanButton_Click"
                MinWidth="80"
                ToolTip="Scan (F5)" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBgSidebar}"
            BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready"
                   Foreground="{StaticResource BrushTextSecondary}" FontSize="11"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock x:Name="CatalogCountLabel" Text="Objects: —" Margin="8,0,0,0"
                     Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
          <TextBlock x:Name="ConflictCountLabel" Text="Conflicts: —" Margin="12,0,0,0"
                     Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
          <TextBlock x:Name="ValidationLabel" Text="Validation: —" Margin="12,0,0,0"
                     Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
          <TextBlock Text="v2.1" Margin="14,0,0,0"
                     Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}"
              BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="NavScroll"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
          <StackPanel Margin="0,6,0,10" x:Name="NavPanel">
            <TextBlock Text="MACHINE" Style="{StaticResource SidebarGroupLabel}" Margin="12,4,8,2" />
            <Button x:Name="NavHome" Content="Machine Overview" Style="{StaticResource SidebarButtonSelected}"
                    Click="Nav_Click" Tag="home" />

            <StackPanel x:Name="DomainNavPanel" />

            <Border Style="{StaticResource SectionRule}" Margin="10,8,10,2" />
            <TextBlock Text="KNOWLEDGE" Style="{StaticResource SidebarGroupLabel}" Foreground="{StaticResource BrushDomainKnowledge}" />
            <Button x:Name="NavConflicts" Content="Conflicts" Style="{StaticResource SidebarButton}"
                    Click="Nav_Click" Tag="conflicts" />
            <Button x:Name="NavKnowledge" Content="Knowledge Explorer" Style="{StaticResource SidebarButton}"
                    Click="Nav_Click" Tag="knowledge" />

            <Border Style="{StaticResource SectionRule}" Margin="10,8,10,2" />
            <TextBlock Text="ABOUT" Style="{StaticResource SidebarGroupLabel}" />
            <Button Content="About" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="about" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <DockPanel Grid.Column="1" Background="{StaticResource BrushBgWindow}">
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgContent}"
                BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="0,0,0,1"
                Padding="16,6">
          <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,18"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="ContentHost" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
