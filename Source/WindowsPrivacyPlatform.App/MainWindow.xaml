<ui:FluentWindow x:Class="WindowsPrivacyPlatform.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsPrivacyPlatform.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="" Height="860" Width="1320" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Background="{DynamicResource BrushBgWindow}" Foreground="{DynamicResource BrushTextPrimary}">
  <ui:FluentWindow.Resources>
    <local:SubtractConverter x:Key="ContentWidthConverter" Amount="40" />
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                 ShowClose="True" ShowMaximize="True" ShowMinimize="True"/>

    <Menu Grid.Row="1" Background="{DynamicResource BrushBgMenu}"
          BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,0,0,1">
      <MenuItem Header="_File">
        <MenuItem Header="_Scan" InputGestureText="F5" Click="MenuScan_Click"/>
        <Separator/>
        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Find…" InputGestureText="Ctrl+F" Click="MenuSearch_Click"/>
        <MenuItem Header="_Copy search text" Click="MenuCopySearch_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Dashboard" Click="MenuHome_Click"/>
        <MenuItem Header="_Privacy" Click="PrivacySection_Click"/>
        <MenuItem Header="_Security" Click="SecuritySection_Click"/>
        <MenuItem Header="_Network" Click="NetworkSection_Click"/>
        <MenuItem Header="Troubleshoot/_Explore" Click="ExploreSection_Click"/>
        <Separator/>
        <MenuItem Header="System E_xplorer" Click="MenuInventory_Click"/>
        <MenuItem Header="_Conflicts" Click="MenuConflicts_Click"/>
        <MenuItem Header="_Knowledge Explorer" Click="MenuKnowledge_Click"/>
        <Separator/>
        <MenuItem Header="_Back" InputGestureText="Alt+Left" Click="BackButton_Click"/>
        <MenuItem Header="_Forward" InputGestureText="Alt+Right" Click="ForwardButton_Click"/>
        <MenuItem Header="Toggle _Navigation Pane" Click="ToggleSidebar_Click"/>
        <MenuItem Header="_Refresh" InputGestureText="Ctrl+R" Click="MenuScan_Click"/>
      </MenuItem>
      <MenuItem Header="_Settings">
        <MenuItem Header="_App Settings" Click="MenuSettings_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="MenuAbout_Click"/>
      </MenuItem>
    </Menu>

    <Border Grid.Row="2" Background="{DynamicResource BrushHeaderChrome}"
            BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,0,0,1"
            Padding="12,8,12,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource ActionNeutral}" Width="36" Height="34" Padding="0"
                Margin="0,0,9,0" ToolTip="Toggle navigation pane" Click="ToggleSidebar_Click">
          <ui:SymbolIcon Symbol="AppsListDetail24" Width="18"/>
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Image Width="32" Height="32" Source="Assets/WindowsPrivacyPlatform.png" Stretch="Uniform"
                 Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ProductNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="HeaderVersionText" Margin="8,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="ScanTimeLabel" Text="Not scanned" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <Button x:Name="BackButton" Style="{StaticResource ActionNeutral}" Width="34" Height="34" Padding="0"
                  ToolTip="Back (Alt+Left)" Click="BackButton_Click" IsEnabled="False">
            <ui:SymbolIcon Symbol="ArrowLeft24" Width="17"/>
          </Button>
          <Button x:Name="ForwardButton" Style="{StaticResource ActionNeutral}" Width="34" Height="34" Padding="0"
                  Margin="5,0,0,0" ToolTip="Forward (Alt+Right)" Click="ForwardButton_Click" IsEnabled="False">
            <ui:SymbolIcon Symbol="ArrowRight24" Width="17"/>
          </Button>
        </StackPanel>

        <Border Grid.Column="3" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="4" Height="34" Margin="0,0,12,0" MaxWidth="440" HorizontalAlignment="Stretch">
          <DockPanel>
            <ui:SymbolIcon Symbol="Search24" Width="18" Margin="9,0,5,0" Foreground="{DynamicResource BrushTextMuted}"/>
            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown" ToolTip="Search the local catalog (Ctrl+F)"/>
          </DockPanel>
        </Border>

        <Border Grid.Column="4" Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushAccent}"
                BorderThickness="1" CornerRadius="4" Padding="8,0" Height="34" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ShieldKeyhole24" Width="16" Margin="0,0,6,0"/>
            <ComboBox x:Name="ModeCombo" Width="128" BorderThickness="0" Background="Transparent"
                      SelectedIndex="0" VerticalContentAlignment="Center"
                      SelectionChanged="ModeCombo_SelectionChanged" DropDownOpened="ModeCombo_DropDownOpened" ToolTip="Session authority">
              <ComboBoxItem Content="View-only" IsSelected="True"/><ComboBoxItem Content="Administrator"/>
            </ComboBox>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="5" Orientation="Horizontal">
          <Button x:Name="CancelScanButton" Content="Cancel" Style="{StaticResource ActionNeutral}"
                  Click="CancelScanButton_Click" MinWidth="68" Height="34" Margin="0,0,6,0" Visibility="Collapsed"/>
          <Button x:Name="ScanButton" Style="{StaticResource ActionPrimary}" Click="ScanButton_Click" Height="34" MinWidth="88" ToolTip="Scan (F5)">
            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" Width="17" Margin="0,0,6,0"/><TextBlock x:Name="ScanButtonLabel" Text="Scan"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ProgressBar x:Name="ScanProgress" Grid.Row="3" IsIndeterminate="True" Height="2" Visibility="Collapsed"/>

    <Border Grid.Row="4" Background="{DynamicResource BrushBgHeader}"
            BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,0,0,1" Padding="14,11">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PrivacySectionButton" Style="{StaticResource SectionToggleSelected}" Click="PrivacySection_Click">
            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="AppsListDetail24" Width="18" Margin="0,0,7,0"/><TextBlock Text="Privacy"/></StackPanel>
          </Button>
          <Button x:Name="SecuritySectionButton" Style="{StaticResource SectionToggle}" Click="SecuritySection_Click">
            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Shield24" Width="18" Margin="0,0,7,0"/><TextBlock Text="Security"/></StackPanel>
          </Button>
          <Button x:Name="NetworkSectionButton" Style="{StaticResource SectionToggle}" Click="NetworkSection_Click">
            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WifiLock24" Width="18" Margin="0,0,7,0"/><TextBlock Text="Network"/></StackPanel>
          </Button>
          <Button x:Name="ExploreSectionButton" Style="{StaticResource SectionToggle}" Click="ExploreSection_Click">
            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Desktop24" Width="18" Margin="0,0,7,0"/><TextBlock Text="Troubleshoot/Explore"/></StackPanel>
          </Button>
        </StackPanel>
        <Border Grid.Column="1" Width="1" Height="32" Background="{DynamicResource BrushBorderStrong}" Margin="6,0,14,0"/>
        <StackPanel Grid.Column="2" x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="252" MinWidth="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource BrushSidebarChrome}"
              BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,0,1,0">
        <Grid x:Name="NavPanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <Border x:Name="RailAccentBorder" Grid.Row="0" BorderBrush="{DynamicResource BrushDomainPrivacy}"
                  BorderThickness="4,0,0,1" Padding="15,14,10,12" Background="{DynamicResource BrushSidebarHover}">
            <StackPanel>
              <TextBlock Text="ACTIVE SECTION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushSidebarMuted}"/>
              <TextBlock x:Name="ActiveSectionTitle" Text="Privacy" Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushDomainPrivacy}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" x:Name="NavScroll">
            <StackPanel Margin="0,7,0,10">
              <StackPanel x:Name="PrivacyNavPanel">
                <Expander Header="PRIVACY CONTROLS" Style="{StaticResource RailExpander}" IsExpanded="True">
                  <StackPanel Margin="-10,4,-8,2">
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:ConsentStore"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="AppsListDetail24" Width="17" Margin="0,0,8,0"/><TextBlock Text="App permissions"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:AppPrivacy"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WindowSettings20" Width="17" Margin="0,0,8,0"/><TextBlock Text="App policy controls"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Telemetry"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DataUsage24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Diagnostics &amp; feedback"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Location"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Location24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Location"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:CloudContent"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PersonSettings20" Width="17" Margin="0,0,8,0"/><TextBlock Text="Personalization"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Advertising"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Megaphone24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Advertising"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:ActivityHistory"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Activity"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Device"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DeviceEq24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Device privacy"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Speech"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Mic24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Speech"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Clipboard"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Clipboard24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Clipboard"/></StackPanel></Button>
                  </StackPanel>
                </Expander>
                <Expander Header="WINDOWS APPS" Style="{StaticResource RailExpander}" IsExpanded="True">
                  <StackPanel Margin="-10,4,-8,2">
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Copilot"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Sparkle24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Copilot"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Recall"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Recall &amp; Click to Do"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Search"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Search"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Edge"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Globe24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Microsoft Edge"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Widgets"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WindowApps24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Widgets"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:OneDrive"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Cloud24" Width="17" Margin="0,0,8,0"/><TextBlock Text="OneDrive"/></StackPanel></Button>
                  </StackPanel>
                </Expander>
                <Expander Header="DEVICE &amp; ACCOUNT" Style="{StaticResource RailExpander}" IsExpanded="True">
                  <StackPanel Margin="-10,4,-8,2">
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:FamilySafety"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="People24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Family Safety"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Storage"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Database24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Storage"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Accessibility"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Accessibility24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Accessibility"/></StackPanel></Button>
                  </StackPanel>
                </Expander>
              </StackPanel>

              <StackPanel x:Name="SecurityNavPanel" Visibility="Collapsed">
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Defender"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Shield24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Microsoft Defender"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:ExploitProtection"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ShieldTask24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Attack surface reduction"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:BitLocker"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="LockClosed24" Width="17" Margin="0,0,8,0"/><TextBlock Text="BitLocker"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Uac"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ShieldKeyhole24" Width="17" Margin="0,0,8,0"/><TextBlock Text="User Account Control"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Biometrics"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Fingerprint20" Width="17" Margin="0,0,8,0"/><TextBlock Text="Biometrics"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:WindowsHello"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WindowFingerprint24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Windows Hello"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:LocalSecurity"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Key24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Local security"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:WindowsUpdate"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Windows Update"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:FindMyDevice"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Location24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Find My Device"/></StackPanel></Button>
              </StackPanel>

              <StackPanel x:Name="NetworkNavPanel" Visibility="Collapsed">
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Network"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WifiLock24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Adapters, LAN &amp; DNS"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:Firewall"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="GlobeShield24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Firewall"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="domain:RemoteAccess"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Remote20" Width="17" Margin="0,0,8,0"/><TextBlock Text="Remote access"/></StackPanel></Button>
              </StackPanel>

              <StackPanel x:Name="ExploreNavPanel" Visibility="Collapsed">
                <TextBlock Text="READ-ONLY DIAGNOSTICS" Style="{StaticResource SidebarGroupLabel}" Margin="15,4,8,7"/>
                <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="inventory"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Desktop24" Width="17" Margin="0,0,8,0"/><TextBlock Text="System Explorer"/></StackPanel></Button>
                <TextBlock Text="Inventory and fixed observations only. Service actions are not exposed here."
                           Margin="15,9,14,0" FontSize="10.5" Foreground="{DynamicResource BrushSidebarMuted}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorderRule}" BorderThickness="0,1,0,0" Padding="0,7,0,9">
            <StackPanel>
              <TextBlock Text="PERSISTENT" Style="{StaticResource SidebarGroupLabel}" Margin="15,4,8,5"/>
              <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="home"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Dashboard"/></StackPanel></Button>
              <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="conflicts"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Warning24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Conflicts"/></StackPanel></Button>
              <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="knowledge"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="BookInformation24" Width="17" Margin="0,0,8,0"/><TextBlock Text="Knowledge Explorer"/></StackPanel></Button>
              <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="settings"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Width="17" Margin="0,0,8,0"/><TextBlock Text="App Settings"/></StackPanel></Button>
              <Button Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="about"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Info24" Width="17" Margin="0,0,8,0"/><TextBlock Text="About"/></StackPanel></Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Background="{DynamicResource BrushBgWindow}">
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" Padding="22,18,22,22" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" ScrollChanged="ContentScroll_ScrollChanged">
          <ContentControl x:Name="ContentHost"
                          Width="{Binding ActualWidth, ElementName=ContentScroll, Converter={StaticResource ContentWidthConverter}}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </ScrollViewer>
        <Button x:Name="BackToTopButton" Content="↑  Back to top" Style="{StaticResource ActionNeutral}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Visibility="Collapsed"
                Click="BackToTopButton_Click"/>
      </Grid>
    </Grid>

    <Border Grid.Row="6" Background="{DynamicResource BrushBgMenu}" BorderBrush="{DynamicResource BrushBorderStrong}"
            BorderThickness="0,1,0,0" Padding="12,5">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready" AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock x:Name="CatalogCountLabel" Text="Settings: —" Margin="8,0,0,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
          <TextBlock x:Name="ConflictCountLabel" Text="Conflicts: —" Margin="12,0,0,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
          <TextBlock x:Name="FooterVersionText" Margin="14,0,0,0" Foreground="{DynamicResource BrushAccent}" FontSize="11" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
