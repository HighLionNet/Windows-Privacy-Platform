<Window x:Class="WindowsPrivacyPlatform.App.HighImpactWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High-impact change" SizeToContent="WidthAndHeight" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushBgWindow}">
  <Border Padding="22" Background="{DynamicResource BrushBgContent}" BorderBrush="{DynamicResource BrushConflict}" BorderThickness="4,1,1,1">
    <StackPanel>
      <TextBlock Text="High-impact change" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="ChangeText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13"/>
      <TextBlock x:Name="RiskText" Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
      <TextBlock Text="Windows will ask you to verify an administrator credential before the normal batch confirmation. Cancelling either step writes nothing."
                 Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Content="Cancel" Style="{StaticResource ActionNeutral}" MinHeight="42" Click="Cancel_Click"/>
        <Button Grid.Column="2" Content="Continue" Style="{StaticResource ActionDanger}" MinHeight="42" Click="Continue_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
