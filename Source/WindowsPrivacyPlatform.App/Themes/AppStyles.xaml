<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Windows management console palette (Event Viewer / Device Manager / MMC family) -->
  <Color x:Key="BgWindow">#F0F0F0</Color>
  <Color x:Key="BgSidebar">#F3F3F3</Color>
  <Color x:Key="BgContent">#FFFFFF</Color>
  <Color x:Key="BgCard">#FFFFFF</Color>
  <Color x:Key="BgHover">#E5E5E5</Color>
  <Color x:Key="BgSelected">#CCE8FF</Color>
  <Color x:Key="BgSelectedBorder">#0078D4</Color>
  <Color x:Key="BgHeader">#F8F8F8</Color>
  <Color x:Key="BgAltRow">#FAFAFA</Color>
  <Color x:Key="BorderSubtle">#D0D0D0</Color>
  <Color x:Key="BorderStrong">#A0A0A0</Color>
  <Color x:Key="BorderRule">#C8C8C8</Color>
  <Color x:Key="TextPrimary">#1A1A1A</Color>
  <Color x:Key="TextSecondary">#4A4A4A</Color>
  <Color x:Key="TextMuted">#6B6B6B</Color>
  <Color x:Key="Accent">#0078D4</Color>
  <Color x:Key="AccentSoft">#DEECF9</Color>
  <Color x:Key="Warning">#9A5B00</Color>
  <Color x:Key="WarningSoft">#FFF4CE</Color>
  <Color x:Key="Error">#C42B1C</Color>
  <Color x:Key="Success">#0F7B0F</Color>
  <Color x:Key="SuccessSoft">#DFF6DD</Color>
  <Color x:Key="Unknown">#605E5C</Color>
  <Color x:Key="UnknownSoft">#F3F2F1</Color>
  <Color x:Key="Conflict">#CA5010</Color>
  <Color x:Key="ConflictSoft">#FDE7D9</Color>

  <SolidColorBrush x:Key="BrushBgWindow" Color="{StaticResource BgWindow}" />
  <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource BgSidebar}" />
  <SolidColorBrush x:Key="BrushBgContent" Color="{StaticResource BgContent}" />
  <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource BgCard}" />
  <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource BgHover}" />
  <SolidColorBrush x:Key="BrushBgSelected" Color="{StaticResource BgSelected}" />
  <SolidColorBrush x:Key="BrushBgHeader" Color="{StaticResource BgHeader}" />
  <SolidColorBrush x:Key="BrushBgAltRow" Color="{StaticResource BgAltRow}" />
  <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderSubtle}" />
  <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource BorderStrong}" />
  <SolidColorBrush x:Key="BrushBorderRule" Color="{StaticResource BorderRule}" />
  <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
  <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />
  <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource AccentSoft}" />
  <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource Warning}" />
  <SolidColorBrush x:Key="BrushWarningSoft" Color="{StaticResource WarningSoft}" />
  <SolidColorBrush x:Key="BrushError" Color="{StaticResource Error}" />
  <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource Success}" />
  <SolidColorBrush x:Key="BrushSuccessSoft" Color="{StaticResource SuccessSoft}" />
  <SolidColorBrush x:Key="BrushUnknown" Color="{StaticResource Unknown}" />
  <SolidColorBrush x:Key="BrushUnknownSoft" Color="{StaticResource UnknownSoft}" />
  <SolidColorBrush x:Key="BrushConflict" Color="{StaticResource Conflict}" />
  <SolidColorBrush x:Key="BrushConflictSoft" Color="{StaticResource ConflictSoft}" />

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BrushBgWindow}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
  </Style>

  <!-- Sidebar navigation — structural, not decorative buttons -->
  <Style x:Key="SidebarButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SidebarButtonSelected" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
    <Setter Property="Background" Value="{StaticResource BrushBgSelected}" />
    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderThickness="3,0,0,0" BorderBrush="{StaticResource BrushAccent}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgSelected}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SidebarGroupLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    <Setter Property="Margin" Value="12,12,8,2" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- Horizontal rule used between operational sections -->
  <Style x:Key="SectionRule" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushBorderRule}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8,0,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="HeaderRule" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushBorder}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,2,0,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Bordered section surface (property sheet group) -->
  <Style x:Key="PropertyGroup" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushBgContent}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Accent primary block (current config) -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushBgContent}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="CardAccent" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="BorderThickness" Value="3,1,1,1" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
  </Style>

  <Style x:Key="CardConflict" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="BorderThickness" Value="3,1,1,1" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushConflict}" />
  </Style>

  <!-- Dense list rows — bottom border only, management-console style -->
  <Style x:Key="ListRow" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushBgContent}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style x:Key="ListRowConflict" TargetType="Border" BasedOn="{StaticResource ListRow}">
    <Setter Property="BorderThickness" Value="3,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushConflict}" />
    <Setter Property="Background" Value="{StaticResource BrushConflictSoft}" />
  </Style>

  <Style x:Key="ListHeader" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushBgHeader}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style x:Key="ListContainer" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushBgContent}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,0" />
  </Style>

  <Style x:Key="SectionSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="Margin" Value="0,1,0,6" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="GroupHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>

  <Style x:Key="LabelMuted" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
  </Style>

  <Style x:Key="ValueText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="PrimaryValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MetaText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
  </Style>

  <!-- Property-sheet label | value pair -->
  <Style x:Key="PropLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,12,2" />
  </Style>

  <Style x:Key="PropValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
  </Style>

  <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource BrushSuccessSoft}" />
  </Style>

  <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource BrushWarningSoft}" />
  </Style>

  <Style x:Key="BadgeConflict" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource BrushConflictSoft}" />
  </Style>

  <Style x:Key="BadgeUnknown" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource BrushUnknownSoft}" />
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="0" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource BrushBgHover}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
  </Style>

  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style x:Key="BreadcrumbText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="BreadcrumbLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="DetailExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>

</ResourceDictionary>
