<Window x:Class="WindowsPrivacyPlatform.App.ChangeConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm changes" Width="650" MaxHeight="700" SizeToContent="Height"
        MinHeight="280" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" Text="Review changes" Style="{StaticResource SectionTitle}" />
    <TextBlock Grid.Row="1" Margin="0,4,0,14" TextWrapping="Wrap"
               Foreground="{DynamicResource BrushTextSecondary}"
               Text="Nothing is written until you confirm. Each target is checked again and independently read back." />
    <Border Grid.Row="2" Style="{StaticResource ListContainer}" MaxHeight="470">
      <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <ItemsControl x:Name="ChangesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource ListRow}" Cursor="Arrow">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                  <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Current" Foreground="{DynamicResource BrushTextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Current}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="New" Margin="0,3,0,0" Foreground="{DynamicResource BrushTextMuted}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Intended}" Margin="0,3,0,0"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Style="{StaticResource ActionNeutral}" IsCancel="True" MinWidth="110" />
      <Button Content="Confirm changes" Style="{StaticResource ActionPrimary}" MinWidth="150" Margin="10,0,0,0"
              Click="Confirm_Click" />
    </StackPanel>
  </Grid>
</Window>
