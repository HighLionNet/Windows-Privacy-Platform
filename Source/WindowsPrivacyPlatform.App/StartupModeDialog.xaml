<Window x:Class="WindowsPrivacyPlatform.App.StartupModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session mode" Width="680" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Choose how to open" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Margin="0,6,0,18" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
               Text="Both modes scan locally. Only Administrator mode can change the verified settings shown by the app."/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardAccent}" Margin="0,0,8,0" Padding="16" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource BadgeSuccess}"><TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold"/></Border>
            <TextBlock Text="Administrator" FontSize="18" FontWeight="SemiBold"/></DockPanel>
          <TextBlock Grid.Row="1" Margin="0,10,0,14" TextWrapping="Wrap" LineHeight="20"
                     Text="Windows UAC decides whether this account can elevate. Every change still requires confirmation and verified read-back."/>
          <Button x:Name="AdminButton" Grid.Row="2" Content="Continue to Administrator" Style="{StaticResource ActionPrimary}" Click="Admin_Click"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardAccent}" Margin="8,0,0,0" Padding="16" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="View-only" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Margin="0,10,0,14" TextWrapping="Wrap" LineHeight="20"
                     Text="Review local configuration and inventory without requesting elevation or changing Windows."/>
          <Button x:Name="ViewOnlyButton" Grid.Row="2" Content="Continue in View-only" Style="{StaticResource ActionPrimary}" Click="ViewOnly_Click"/>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
               Text="WPP delegates elevation to Windows UAC. Windows may show a consent button or request an eligible account."/>
  </Grid>
</Window>
