<Window x:Class="WindowsPrivacyPlatform.App.StartupModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session mode" Width="680" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Choose how to open" FontSize="24" FontWeight="SemiBold" />
    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardAccent}" Margin="0,0,8,0" Padding="16" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource BadgeSuccess}"><TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold"/></Border>
            <TextBlock Text="Administrator" FontSize="18" FontWeight="SemiBold"/></DockPanel>
          <Button x:Name="AdminButton" Grid.Row="1" Margin="0,18,0,0" VerticalAlignment="Bottom"
                  Content="Continue to Administrator" Style="{StaticResource ActionPrimary}" Click="Admin_Click"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardAccent}" Margin="8,0,0,0" Padding="16" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="View-only" FontSize="18" FontWeight="SemiBold"/>
          <Button x:Name="ViewOnlyButton" Grid.Row="1" Margin="0,18,0,0" VerticalAlignment="Bottom"
                  Content="Continue in View-only" Style="{StaticResource ActionPrimary}" Click="ViewOnly_Click"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
