<Window x:Class="WindowsPrivacyPlatform.App.StartupModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Privacy Platform"
        Width="720" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgWindow}"
        ShowInTaskbar="True">
  <Grid Margin="36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="How would you like to begin?"
               FontSize="28" FontWeight="SemiBold"
               Foreground="{StaticResource BrushTextPrimary}" />
    <TextBlock Grid.Row="1" Margin="0,10,0,26"
               Text="Choose a mode for this session. You can return to Inspect mode at any time."
               FontSize="14" Foreground="{StaticResource BrushTextSecondary}" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Click="Inspect_Click" Padding="24" Cursor="Hand"
              Background="{StaticResource BrushBgContent}"
              BorderBrush="{StaticResource BrushAccent}" BorderThickness="2">
        <StackPanel>
          <TextBlock Text="Inspect" FontSize="24" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushAccent}" />
          <TextBlock Text="Read-only · Recommended" Margin="0,10,0,14"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextPrimary}" />
          <TextBlock Text="Scan and explain Windows configuration without Administrator access or system changes."
                     TextWrapping="Wrap" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </StackPanel>
      </Button>

      <Button Grid.Column="2" Click="Modify_Click" Padding="24" Cursor="Hand"
              Background="{StaticResource BrushBgHeader}"
              BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="2">
        <StackPanel>
          <TextBlock Text="Modify" FontSize="24" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextPrimary}" />
          <TextBlock Text="Administrator required" Margin="0,10,0,14"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextPrimary}" />
          <TextBlock Text="Inspect first, then change one explicitly supported setting at a time with confirmation and read-back verification."
                     TextWrapping="Wrap" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </StackPanel>
      </Button>
    </Grid>

    <TextBlock Grid.Row="3" Margin="0,24,0,0"
               Text="Understand first. Change deliberately. Never invent certainty."
               FontSize="12" FontStyle="Italic" HorizontalAlignment="Center"
               Foreground="{StaticResource BrushTextMuted}" />
  </Grid>
</Window>
